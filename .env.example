# ===========================================
# CONFIGURACIÓN DEL SERVIDOR
# ===========================================

# Puerto donde se ejecutará el servidor
PORT=3000

# Entorno de ejecución (development, production)
NODE_ENV=development

# ===========================================
# CONFIGURACIÓN DE SEGURIDAD
# ===========================================

# Token para autenticación de API
# IMPORTANTE: Cambiar por un token seguro y único
API_TOKEN=cambiar-por-token-seguro

# ===========================================
# CONFIGURACIÓN S3
# ===========================================

# Endpoint del servicio S3
# Para Amazon S3: https://s3.amazonaws.com
# Para Cloudflare R2: https://tu-account-id.r2.cloudflarestorage.com
S3_ENDPOINT=https://s3.amazonaws.com

# Nombre del bucket donde se almacenarán los backups
S3_BUCKET=mi-bucket-backup

# Credenciales de acceso S3
S3_ACCESS_KEY_ID=tu-access-key-aqui
S3_SECRET_ACCESS_KEY=tu-secret-key-aqui

# Región del bucket S3
S3_REGION=us-east-1

# ===========================================
# CONFIGURACIÓN DE BASE DE DATOS
# ===========================================

# Tipo de base de datos (postgresql, mysql)
DB_TYPE=postgresql

# --- PostgreSQL (DB_TYPE=postgresql) ---
# PostgreSQL se configura con una única cadena de conexión.
# Formato: postgresql://usuario:password@host:puerto/base_datos
# Si la contraseña contiene caracteres especiales (@ : / ?), codifícalos
# (por ejemplo, '@' -> '%40').
DB_CONNECTION_STRING=postgresql://tu-usuario-bd:tu-password-bd@localhost:5432/tu-base-datos

# --- MySQL (DB_TYPE=mysql) ---
# MySQL se configura con valores sueltos (ignorados si DB_TYPE=postgresql).
#DB_HOST=localhost
#DB_PORT=3306
#DB_USERNAME=tu-usuario-bd
#DB_PASSWORD=tu-password-bd
#DB_DATABASE=tu-base-datos

# Herramienta de backup MySQL: solo aplica si DB_TYPE=mysql
# Opciones: 'mysqlsh' (MySQL Shell) o 'mysqldump' (tradicional)
# Con DB_TYPE=postgresql esta variable se ignora: siempre se usa pg_dump
#MYSQL_BACKUP_TOOL=mysqldump

# ===========================================
# CONFIGURACIÓN OPCIONAL
# ===========================================

# Nivel de logs (error, warn, info, debug)
LOG_LEVEL=info

# Directorio para archivos temporales
# TEMP_DIR=./temp

# Directorio para logs
# LOG_DIR=./logs

# ===========================================
# EJEMPLOS DE CONFIGURACIÓN
# ===========================================

# Ejemplo para Cloudflare R2:
# S3_ENDPOINT=https://1234567890abcdef.r2.cloudflarestorage.com
# S3_REGION=auto

# Ejemplo para PostgreSQL:
# DB_TYPE=postgresql
# DB_CONNECTION_STRING=postgresql://usuario:password@mi-servidor-pg.com:5432/mi-base

# Ejemplo para MySQL remoto:
# DB_TYPE=mysql
# DB_HOST=mi-servidor-mysql.com
# DB_PORT=3306

# ===========================================
# NOTAS IMPORTANTES
# ===========================================

# 1. Nunca commitear este archivo con credenciales reales
# 2. Usar tokens largos y aleatorios para API_TOKEN
# 3. Verificar que el bucket S3 existe y tiene permisos correctos
# 4. Probar conexión a la base de datos antes de usar
# 5. En producción, usar variables de entorno del sistema