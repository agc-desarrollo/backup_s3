{
  "name": "backup-s3-system",
  "version": "1.0.0",
  "description": "API simplificada de backup automatizado para respaldar carpetas y bases de datos a S3",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node test-api-services.js",
